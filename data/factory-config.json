{
  "schema_version": 1,
  "production_domain": "https://app.rentbikehanoi.com",
  "target_total_content_pages": 1000,
  "batch_size": 10,
  "first_pass_min_words": 1200,
  "first_pass_min_internal_links": 3,
  "first_pass_max_internal_links": 10,
  "max_repair_attempts": 2,
  "auto_claim_next": true,
  "stop_on_blocked": true,
  "excluded_roles": [
    "LEGAL"
  ],
  "draft_extension": ".article",
  "inbox_dir": "factory/inbox",
  "matrix_path": "data/content-matrix.csv",
  "writer_queue_path": "data/writer-queue.json",
  "state_path": "data/factory-state.json",
  "report_path": "reports/factory-last-run.json"
}
